<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Calculator</title>
		<style>
			/* Inline pretty styles */
			:root{--bg:#eef6ff;--card:#ffffff;--primary:#0b63ff;--muted:#556;--danger:#b91c1c}
			*{box-sizing:border-box}
			body{margin:0;padding:24px;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:var(--bg);display:flex;align-items:center;justify-content:center;min-height:100vh}
			.card{width:100%;max-width:480px;background:var(--card);border-radius:14px;padding:20px;box-shadow:0 8px 30px rgba(10,20,50,0.08)}
			h1{margin:0 0 10px;font-size:20px;color:#0f1724}
			.inputs{display:flex;gap:12px;margin-bottom:14px}
			.inputs input{flex:1;padding:12px;border-radius:10px;border:1px solid #e6eefc;font-size:16px}
			.btns{display:flex;gap:10px;margin-bottom:14px}
			.btn{flex:1;padding:12px;border-radius:10px;border:0;background:linear-gradient(180deg,var(--primary),#0552d4);color:white;font-weight:700;cursor:pointer}
			.btn.secondary{background:linear-gradient(180deg,#6b7280,#4b5563)}
			.controls{display:flex;align-items:center;justify-content:space-between;gap:12px}
			.result{margin-top:12px;padding:14px;border-radius:10px;background:#f8fbff;border:1px solid #e6f0ff;text-align:center}
			.result .label{font-size:12px;color:var(--muted)}
			.result .value{font-size:28px;font-weight:800;color:var(--primary);margin-top:6px}
			.error{color:var(--danger);text-align:center;margin-top:8px}
			.clear{background:#fff;border:1px solid #e6eefc;color:#111;padding:10px 12px;border-radius:10px;cursor:pointer}
			@media (max-width:520px){.inputs{flex-direction:column}.btns{flex-direction:column}.clear{width:100%}}
		</style>
	</head>
	<body>
		<div class="card">
			<h1>Calculator</h1>

			<div class="inputs">
				<input id="a" type="number" placeholder="First number" inputmode="decimal">
				<input id="b" type="number" placeholder="Second number" inputmode="decimal">
			</div>

			<div class="btns">
				<button id="add" class="btn">Add</button>
				<button id="sub" class="btn secondary">Subtract</button>
				<button id="mul" class="btn">Multiply</button>
				<button id="div" class="btn secondary">Divide</button>
			</div>

			<div class="controls">
				<button id="clear" class="clear">Clear</button>
				<div style="flex:1"></div>
			</div>

			<div class="result" id="result">
				<div class="label" id="resultLabel">Result</div>
				<div class="value" id="resultValue">—</div>
			</div>

			<div class="error" id="error" aria-live="polite"></div>
		</div>

		<script>
			// Elements
			const aEl = document.getElementById('a');
			const bEl = document.getElementById('b');
			const addBtn = document.getElementById('add');
			const subBtn = document.getElementById('sub');
			const mulBtn = document.getElementById('mul');
			const divBtn = document.getElementById('div');
			const clearBtn = document.getElementById('clear');
			const resultLabel = document.getElementById('resultLabel');
			const resultValue = document.getElementById('resultValue');
			const errorEl = document.getElementById('error');

			function showError(msg){ errorEl.textContent = msg }
			function clearError(){ errorEl.textContent = '' }

			function parseInputs(){
				clearError();
				const a = aEl.value;
				const b = bEl.value;
				if (a === '' || b === ''){ showError('Please fill both numbers'); return null }
				const an = parseFloat(a);
				const bn = parseFloat(b);
				if (!isFinite(an) || !isFinite(bn)){ showError('Invalid number'); return null }
				return {an,bn};
			}

			function formatNumber(n){
				if (typeof n !== 'number' || !isFinite(n)) return '—';
				if (Number.isInteger(n)) return String(n);
				return Number(n.toFixed(6)).toString();
			}

			function setResult(label, value){
				resultLabel.textContent = label;
				resultValue.textContent = formatNumber(value);
			}

			addBtn.addEventListener('click', ()=>{
				const p = parseInputs(); if (!p) return; setResult('Addition', p.an + p.bn);
			});
			subBtn.addEventListener('click', ()=>{
				const p = parseInputs(); if (!p) return; setResult('Subtraction', p.an - p.bn);
			});
			mulBtn.addEventListener('click', ()=>{
				const p = parseInputs(); if (!p) return; setResult('Multiplication', p.an * p.bn);
			});
			divBtn.addEventListener('click', ()=>{
				const p = parseInputs(); if (!p) return; if (p.bn === 0){ showError('Cannot divide by zero'); return } setResult('Division', p.an / p.bn);
			});

			clearBtn.addEventListener('click', ()=>{
				aEl.value = '';
				bEl.value = '';
				setResult('Result', '—');
				clearError();
			});

			// Enter triggers add
			[aEl,bEl].forEach(el=>el.addEventListener('keydown', (e)=>{ if (e.key === 'Enter') addBtn.click() }));
		</script>
	</body>
</html>

